# Public connection settings only; never put provider secrets in VITE_ variables.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site

# Server-only Convex environment variables; set in Convex, never in the browser.
# Do not paste these values into chat, docs, or shell output.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
EMAIL_PROVIDER=resend
GITHUB_APP_ID=5172641
GITHUB_APP_PRIVATE_KEY=

# AI lane, tried in this order: Gemini, Ollama Cloud, then plain wording.
# Both are optional. With neither set, plain deterministic wording is shown.
GEMINI_API_KEY=
OLLAMA_API_KEY=
# Optional. Defaults to the small mixture-of-experts cloud model.
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
