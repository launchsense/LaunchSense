# Public connection settings only; never put provider secrets in VITE_ variables.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site

# Server-only Convex environment variables; set in Convex, never in the browser.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_PRIVATE_KEY=
