# Public connection settings only; never put provider secrets in VITE_ variables.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site
# Website visitor counter (PostHog). Both are public client values: the key is a
# public project key, not a secret. Leave VITE_POSTHOG_KEY empty to keep the
# counter off. The default host is EU; use https://us.i.posthog.com for US.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only Convex environment variables; set in Convex, never in the browser.
# Do not paste these values into chat, docs, or shell output.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
EMAIL_PROVIDER=resend
GITHUB_APP_ID=5172641
GITHUB_APP_PRIVATE_KEY=
# Required by POST /api/mcp/usage. Unset means every caller is rejected.
USAGE_ROUTE_KEY=
# Analytics only. The secret the MCP usage row's day-scoped repoKey is HMAC'd
# with. It is never stored, logged, or returned; only its output is. Unset means
# usage rows carry no repoKey at all, which is the honest failure. Rotating it
# breaks same-day joins only. Use 16 characters or more, or it is ignored.
ANALYTICS_DAY_SALT=

# AI lane, tried in this order: Gemini, Ollama Cloud, then plain wording.
# Both are optional. With neither set, plain deterministic wording is shown.
GEMINI_API_KEY=
OLLAMA_API_KEY=
# Optional. Defaults to the small mixture-of-experts cloud model.
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
