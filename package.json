{
  "name": "launchsense",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "check:claims": "node scripts/check-claims.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:claims && npm run check:dco && node --test tests/*.mjs",
    "review:local": "node --experimental-strip-types mcp/review-entry.ts --root .",
    "notices": "node scripts/third-party-notices.mjs",
    "sbom": "node scripts/sbom.mjs",
    "register": "node scripts/processing-register.mjs",
    "consent-record": "node scripts/consent-record.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
