{
  "name": "launchsense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:backend": "convex dev",
    "typecheck": "tsc -b && tsc --noEmit -p convex/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "check:claims": "node scripts/check-claims.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:claims && node --test tests/*.mjs",
    "review:local": "node --experimental-strip-types mcp/review-entry.ts --root .",
    "notices": "node scripts/third-party-notices.mjs",
    "consent-record": "node scripts/consent-record.mjs",
    "register": "node scripts/processing-register.mjs",
    "sbom": "node scripts/sbom.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy": "static-hosting deploy"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/static-hosting": "0.2.1",
    "convex": "1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
